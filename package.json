{
  "name": "afus-boutique",
  "version": "1.1.2",
  "description": "Afus Boutique - offline sales and stock management for Algerian clothing and accessory shops (Windows and macOS desktop, Electron)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint src electron tests --ext .js,.jsx --max-warnings 0",
    "test": "vitest run",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:start": "electron ."
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "electron",
    "retail",
    "clothing"
  ],
  "author": {
    "name": "Afus"
  },
  "license": "MIT",
  "dependencies": {
    "bwip-js": "^4.8.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.11",
    "sql.js": "^1.13.0",
    "uuid": "^9.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "date-fns": "^3.6.0",
    "electron": "^39.2.7",
    "electron-builder": "^24.9.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "katex": "^0.16.27",
    "lucide-react": "^0.303.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.21.1",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^2.10.3",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "wait-on": "^7.2.0",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "dz.afus.boutique",
    "productName": "Afus Boutique",
    "executableName": "AfusBoutique",
    "copyright": "Copyright © Afus. Includes software licensed under the MIT License (see LICENSE.txt).",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE.txt"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "publisherName": "Afus"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Afus Boutique",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "public/icon-512.png",
      "artifactName": "Afus-Boutique-${version}-${arch}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "category": "Office"
    },
    "publish": null,
    "dmg": {
      "artifactName": "Afus-Boutique-${version}-${arch}.${ext}"
    }
  }
}
